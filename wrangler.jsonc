{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-net",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c448bd2e-a468-4a9f-b922-cac94ffd375e","database_name": "web-app-net" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ad109f111fa04700b7942441af16b9d6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
